# Airflow image for the PEA pipeline "composer".
# Airflow itself lives in the base image's environment (SQLAlchemy 1.4). The PEA pipeline is
# installed into a SEPARATE venv at /opt/pipeline (SQLAlchemy 2.0) so the two never clash; the DAGs
# invoke the pipeline as `/opt/pipeline/bin/python -m src <package> <command>`.
FROM apache/airflow:2.10.5-python3.12

# No apt packages needed: psycopg2-binary bundles libpq, and every other pipeline dep ships a
# manylinux wheel (pandas/numpy/scipy/pyarrow/lxml/curl-cffi) -> nothing to compile. This also
# avoids the corporate-proxy apt CA failure.
USER root
# Isolated pipeline venv (SQLAlchemy 2.0) — independent of Airflow's own site-packages.
RUN python -m venv /opt/pipeline
COPY requirements-airflow.txt /tmp/requirements-airflow.txt
RUN /opt/pipeline/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/pipeline/bin/pip install --no-cache-dir -r /tmp/requirements-airflow.txt \
    && chmod -R a+rx /opt/pipeline

USER airflow
